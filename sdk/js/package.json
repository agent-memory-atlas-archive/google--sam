{
  "name": "@agent-mesh/sdk",
  "version": "0.1.0",
  "description": "Native SDK for joining a SAM agent mesh from inside a Node.js agent process",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/sam.git",
    "directory": "sdk/js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test 'build/**/*.test.js'"
  },
  "dependencies": {
    "@biscuit-auth/biscuit-wasm": "^0.6.0",
    "@bufbuild/protobuf": "^2.15.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/circuit-relay-v2": "^4.2.13",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/identify": "^4.1.14",
    "@libp2p/interface": "^3.3.0",
    "@libp2p/tcp": "^11.0.28",
    "@libp2p/tls": "^3.1.10",
    "@libp2p/utils": "^7.4.1",
    "@multiformats/multiaddr": "^13.0.3",
    "libp2p": "^3.3.11"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
